{
  "name": "skillconsole",
  "version": "0.0.0",
  "private": true,
  "description": "A visual workbench for testing Agent Skills.",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "db:check": "npm run db:check --workspace @skillconsole/server",
    "db:generate": "npm run db:generate --workspace @skillconsole/server",
    "db:migrate": "npm run migrate --workspace @skillconsole/server"
  },
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10 <12"
  }
}
