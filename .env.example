# Optional registry or mirror prefix. Include the trailing slash.
# Leave empty to use Docker Hub.
DOCKER_REGISTRY=

# Change this value before exposing a production deployment.
POSTGRES_PASSWORD=skillconsole

# Host port mapped to the SkillConsole API container port 3000.
# Change this when 13000 is already occupied.
SKILLCONSOLE_API_HOST_PORT=13000

# Optional upload safety overrides. Defaults support large Skills while preserving bounded resource use.
# Values are bytes unless the variable name says otherwise.
# SKILLCONSOLE_UPLOAD_MAX_FILES=20000
# SKILLCONSOLE_UPLOAD_MAX_FILE_BYTES=20971520
# SKILLCONSOLE_UPLOAD_MAX_TOTAL_BYTES=209715200
# SKILLCONSOLE_UPLOAD_MAX_DIRECTORY_DEPTH=32
# SKILLCONSOLE_UPLOAD_MAX_PATH_LENGTH=512
# SKILLCONSOLE_UPLOAD_MAX_ZIP_BYTES=104857600
# SKILLCONSOLE_UPLOAD_MAX_ZIP_COMPRESSION_RATIO=100

# Optional absolute path to a custom folder-upload ignore policy.
# SKILLCONSOLE_UPLOAD_FOLDER_IGNORE_CONFIG=/workspace/config/upload-folder-ignore.json
